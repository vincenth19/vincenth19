{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/.next",
			"!**/next-env.d.ts",
			"!**/test-results",
			"!**/playwright-report",
			"!**/*.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"css": {
		"formatter": { "enabled": true, "quoteStyle": "single" },
		"linter": { "enabled": true }
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"domains": { "next": "recommended", "react": "recommended" },
		"rules": {
			"preset": "recommended",
			"performance": {
				"noImgElement": "off"
			},
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["styles/base.css"],
			"linter": {
				"rules": { "complexity": { "noImportantStyles": "off" } }
			}
		}
	]
}
